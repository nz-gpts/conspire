{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conspire attestation",
  "type": "object",
  "required": ["term", "source", "date", "evidence_type"],
  "properties": {
    "term": {"type": "string"},
    "language": {"type": ["string", "null"]},
    "date": {"type": "string"},
    "date_precision": {"enum": ["day", "month", "year", "range", "circa", "unknown"]},
    "source": {"type": "string"},
    "source_url": {"type": ["string", "null"]},
    "quotation": {"type": ["string", "null"]},
    "sense": {"type": ["string", "null"]},
    "evidence_type": {"enum": ["primary", "secondary", "dataset", "corpus"]},
    "confidence": {"enum": ["high", "medium", "low", "unassessed"]},
    "notes": {"type": ["string", "null"]}
  }
}
